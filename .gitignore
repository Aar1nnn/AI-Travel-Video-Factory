# AI Travel Video Factory — .gitignore

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Build artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Environment variables (contains API keys)
.env
.env.*

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Output (generated videos and temp files)
output/
!output/.gitkeep

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp
~$*

# Large media files — keep .gitkeep only
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
!**/.gitkeep

# Image thumbnails
*.jpg
*.png
*.webp
!**/.gitkeep

# Embeddings
*.npy

# Source assets (copyright-sensitive)
assets/china/
assets/raw/*.mp4
assets/processed/*.mp4
assets/thumbnails/*.jpg

# Production artifacts
assets/index_auto_tagged.json

# BGM (copyright-sensitive)
bgm/*.mp3
bgm/*.wav

# Fonts (may have license restrictions)
fonts/*.ttf
fonts/*.otf

# Whisper models (large binary files)
models/
*.pt
*.bin
*.safetensors

# HuggingFace cache
.huggingface/

# Claude Code
.claude/

# Experiments output
experiments/*/output/
experiments/*/downloaded/
experiments/*/raw_downloads/

# Node (Remotion experiments)
node_modules/

# Streamlit
.streamlit/secrets.toml
